{
  "name": "pickam-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build gateway && nest build user-service && nest build wallet-service && nest build order-service && nest build notification-service && nest build admin-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start gateway",
    "start:gateway": "nest start gateway",
    "start:user": "nest start user-service",
    "start:wallet": "nest start wallet-service",
    "start:order": "nest start order-service",
    "start:notification": "nest start notification-service",
    "start:admin": "nest start admin-service",
    "start:gateway:dev": "nest start gateway --watch",
    "start:user:dev": "nest start user-service --watch",
    "start:wallet:dev": "nest start wallet-service --watch",
    "start:order:dev": "nest start order-service --watch",
    "start:notification:dev": "nest start notification-service --watch",
    "start:admin:dev": "nest start admin-service --watch",
    "start:all": "concurrently \"npm run start:gateway\" \"npm run start:user\" \"npm run start:wallet\" \"npm run start:order\" \"npm run start:notification\" \"npm run start:admin\"",
    "start:all:dev": "concurrently \"npm run start:gateway:dev\" \"npm run start:user:dev\" \"npm run start:wallet:dev\" \"npm run start:order:dev\" \"npm run start:notification:dev\" \"npm run start:admin:dev\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/nodemailer": "^8.0.2",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "country-state-city": "^3.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.2.0",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^10.1.1",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^10.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^libs/auth(|/.*)$": "<rootDir>/libs/auth/src/$1",
      "^libs/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^libs/config(|/.*)$": "<rootDir>/libs/config/src/$1",
      "^libs/constants(|/.*)$": "<rootDir>/libs/constants/src/$1",
      "^libs/decorators(|/.*)$": "<rootDir>/libs/decorators/src/$1",
      "^libs/dto(|/.*)$": "<rootDir>/libs/dto/src/$1",
      "^libs/filters(|/.*)$": "<rootDir>/libs/filters/src/$1",
      "^libs/guards(|/.*)$": "<rootDir>/libs/guards/src/$1",
      "^libs/interceptors(|/.*)$": "<rootDir>/libs/interceptors/src/$1",
      "^libs/interfaces(|/.*)$": "<rootDir>/libs/interfaces/src/$1",
      "^libs/logger(|/.*)$": "<rootDir>/libs/logger/src/$1",
      "^libs/prisma(|/.*)$": "<rootDir>/libs/prisma/src/$1",
      "^libs/utils(|/.*)$": "<rootDir>/libs/utils/src/$1"
    }
  }
}
